opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/janestreet_crc"
bug-reports: "https://github.com/janestreet/janestreet_crc/issues"
dev-repo: "git+https://github.com/janestreet/janestreet_crc.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/janestreet_crc/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "core"
  "core_kernel"
  "ppx_jane"
  "dune"        {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Calculate CRC32 checksums"
description: "
Library for calculating CRC32 with both the standard polynomial and custom polynomials.
"
